# Percona Distribution for PostgreSQL image tag.
# 18.4 is the currently documented PostgreSQL 18 Docker tag.
PERCONA_POSTGRES_TAG=16.13

# PostgreSQL bootstrap superuser.
POSTGRES_USER=kong
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Initial application database.
POSTGRES_DB=postgres

# Use SCRAM password authentication for TCP clients.
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_BIND_IP=0.0.0.0
POSTGRES_PORT=5432

# Host directory used for PostgreSQL PGDATA.
# Prefer a dedicated cloud data disk mounted on the host.
POSTGRES_DATA_DIR=/data/postgresql
